%% Figure 3.x  System architecture with icons
%% Uses Mermaid's architecture-beta template (needs Mermaid v11+, e.g. https://mermaid.live).
%% Built-in icons: internet, cloud, database, disk, server.
%% For brand logos (react, python, postgresql): on mermaid.live enable the "logos" icon
%% pack, then swap e.g. (database) -> (logos:postgresql), (server) -> (logos:fastapi).

architecture-beta
    group frontend(internet)[Presentation Vercel]
    group backend(cloud)[Application FastAPI on Render]
    group datastore(cloud)[Data]

    service web(internet)[React Vite TS Tailwind] in frontend

    service api(server)[FastAPI plus JWT] in backend
    service scoring(server)[Scoring engine sklearn XGBoost SHAP] in backend

    service db(database)[PostgreSQL users apps members loans] in datastore
    service files(disk)[trained model file] in datastore

    web:B --> T:api
    api:R --> L:scoring
    api:B --> T:db
    scoring:B --> T:files
    scoring:R --> L:db
