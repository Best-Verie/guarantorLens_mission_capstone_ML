%% Figure 3.x  Class diagram (backend domain & services)  (paste into https://mermaid.live)
classDiagram
  class ScoringService {
    +MODEL, FEATURES, BANDS
    +MEMBERS, communities
    +assess(loan, guarantors)
    +_build_features()
    +_shap()
    +adjust_band()
    +suggest_guarantors()
  }
  class RiskAssessment {
    +risk_score
    +band
    +probability
    +brief
    +reasons
    +flags
    +shap
    +segment
    +unusual
  }
  class ExtraModels {
    +KMeans segmenter
    +IsolationForest anomaly
    +segment(loan)
    +anomaly(loan)
  }
  class ScoringModel {
    +xgboost + calibration
    +monotone constraints
    +features, bands, metrics
    +predict_proba()
  }
  class NetworkData {
    +LOANS, BY_BORROWER, BY_GUARANTOR
    +member_detail()
    +neighborhood()
    +communities()
  }
  class InsightsService {
    +risk index cache
    +weak_links()
    +contagion()
    +early_warning()
    +survival()
  }
  class AuthService {
    +SECRET_KEY, JWT
    +register()
    +login()
    +get_current_user()
  }
  class User {
    +id, email, role
    +hashed_password
  }
  class Application {
    +amount, guarantor_ids
    +risk_score, band, status
    +escalate()
  }
  class Recommendation {
    +decision, note
    +author_role
  }
  ScoringService --> RiskAssessment : returns
  ScoringService --> ScoringModel : uses
  ScoringService --> NetworkData : uses
  ScoringService --> ExtraModels : uses
  InsightsService --> ScoringService : uses
  AuthService --> User : authenticates
  User "1" --> "*" Application : creates
  Application "1" --> "*" Recommendation : has
