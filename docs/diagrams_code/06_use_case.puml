' Figure 3.x  Use-case diagram  (paste into https://www.plantuml.com/plantuml or planttext.com)
@startuml
left to right direction
skinparam packageStyle rectangle
actor "Loan Officer" as LO
actor "Credit Manager" as CM
actor "Admin" as AD

rectangle GuarantorLens {
  usecase "Assess loan risk" as UC1
  usecase "Explain score\n(SHAP + plain)" as UC2
  usecase "Simulate what-if\n& advisor" as UC3
  usecase "Create & escalate\napplication" as UC4
  usecase "Explore member\n& network" as UC5
  usecase "View insights\n& monitoring" as UC6
  usecase "Review queue\n& recommend" as UC7
  usecase "Manage model\n& data" as UC8
}

LO --> UC1
LO --> UC4
LO --> UC5
LO --> UC6
CM --> UC7
CM --> UC1
AD --> UC8

UC1 ..> UC2 : <<include>>
UC1 ..> UC3 : <<include>>
CM --|> LO
@enduml
